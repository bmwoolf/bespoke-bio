// Portable safety policy. The private runtime supplies executor budgets and paths.
params.custom_config_base = ''
params.igenomes_ignore = true
params.publish_dir_mode = 'copy'

docker.enabled = true
docker.cpuLimits = true
docker.writableInputMounts = false
singularity.enabled = false
conda.enabled = false

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    withLabel: 'error_ignore|error_retry' {
        errorStrategy = 'terminate'
        maxRetries = 0
    }
}

trace.enabled = true
report.enabled = true
timeline.enabled = true
